# ========== 服务 ==========
SERVER_HOST=0.0.0.0
# SERVER_PORT 走环境变量
# 后端根路径前缀,匹配前端 vite 代理 /api -> localhost:8813/collect
ROOT_PATH=/collect

# ========== 数据库 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
# DB_USER / DB_PASSWORD 走环境变量
DB_NAME=td_topic_manager

# ========== Telegram(手机号新登录用全局凭证;协议号用号自带 json 凭证) ==========
# TG_API_ID / TG_API_HASH 走环境变量
TG_DEVICE_MODEL=Desktop
TG_APP_VERSION=1.0.1
TG_SYSTEM_LANG=zh

# ========== LLM(deepseek,OpenAI 兼容) ==========
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY 走环境变量
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=30

# ========== 鉴权 ==========
# JWT_SECRET / INIT_ADMIN_PASSWORD 走环境变量
JWT_EXPIRE_MIN=480
# 首次启动若无超级管理员则用以下账号创建(首次登录请立即改密)
INIT_ADMIN_USER=admin

# ========== 风控 ==========
SEND_MIN_INTERVAL_MS=1500
SEND_MAX_PER_MIN_PER_PHONE=8
SEND_REPLY_LOCK_TTL_SEC=2
JOIN_BATCH_JITTER_MIN_SEC=5
JOIN_BATCH_JITTER_MAX_SEC=15
NEW_ACCOUNT_DAILY_MAX=3
TOPIC_OWNER_OFFLINE_THRESHOLD_SEC=300

# ========== 代理(暂不接,留空即直连) ==========
# TD_PROXY_HOST=127.0.0.1
# TD_PROXY_PORT=7890
